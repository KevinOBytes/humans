# Reference-only 1Password CLI template for the attended authenticated smoke.
# Create its ignored local copy with:
#   install -m 600 docs/operations/production-authenticated-smoke.op.env.example .env.authenticated-smoke.op.tpl
# Then edit only the op:// locators for the approved production vault. Never
# replace a locator in this file or its private copy with plaintext.
#
# This profile deliberately contains only the three administrator identifiers
# and one selected second factor. It must not include DATABASE_URL, provider
# credentials, storage credentials, or unrelated application configuration.

ADMIN_EMAIL=op://humans-production/administrator/email
ADMIN_USERNAME=op://humans-production/administrator/username
ADMIN_PASSWORD=op://humans-production/administrator/password

# 1Password resolves this reference to the current TOTP value for the item.
# To consume an approved one-time backup code instead, omit this variable and
# inject PRODUCTION_SMOKE_BACKUP_CODE from an approved one-time secret field.
PRODUCTION_SMOKE_TOTP=op://humans-production/administrator/one-time-password?attribute=otp
