# Reference-only 1Password CLI template for one attended AI provider contract.
# Copy with mode 0600, edit only the op:// references, and run with `op run`.
# This profile must not contain application, database, administrator, email, or
# storage credentials. For a loopback Ollama check, omit TEST_AI_API_KEY and use
# the dedicated local Ollama procedure instead of a hosted-provider secret.
RUN_EXTERNAL_PROVIDER_CONTRACTS=true
TEST_AI_PROVIDER=op://humans-production/ai/provider
TEST_AI_BASE_URL=op://humans-production/ai/base-url
TEST_AI_MODEL=op://humans-production/ai/model
TEST_AI_API_KEY=op://humans-production/ai/api-key
