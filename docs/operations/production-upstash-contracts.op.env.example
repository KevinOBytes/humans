# Reference-only 1Password CLI template for the Upstash contract smoke only.
# Create its ignored local copy with:
#   install -m 600 docs/operations/production-upstash-contracts.op.env.example .env.upstash-contracts.op.tpl
# This profile contains no administrator, database, or object-storage values.

RUN_EXTERNAL_PROVIDER_CONTRACTS=true
UPSTASH_REDIS_REST_URL=op://humans-production/upstash/rest-url
UPSTASH_REDIS_REST_TOKEN=op://humans-production/upstash/rest-token
