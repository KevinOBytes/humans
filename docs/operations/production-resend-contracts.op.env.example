# Reference-only 1Password CLI template for one attended Resend delivery.
# Copy with mode 0600, edit only the op:// references, and run with `op run`.
# TEST_RESEND_RECIPIENT must be an approved acceptance mailbox. This profile
# must not contain application, database, administrator, AI, or storage secrets.
RUN_EXTERNAL_PROVIDER_CONTRACTS=true
TEST_RESEND_API_KEY=op://humans-production/resend/api-key
TEST_RESEND_FROM=op://humans-production/resend/from
TEST_RESEND_RECIPIENT=op://humans-production/resend/acceptance-recipient
