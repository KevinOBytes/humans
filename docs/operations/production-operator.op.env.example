# Reference-only 1Password CLI template for attended administrator recovery.
# Create its ignored local copy with:
#   install -m 600 docs/operations/production-operator.op.env.example .env.operator.op.tpl
# Then change only the `op://` locators to match the approved production vault.
# Never replace a locator in this file or its private copy with plaintext.
#
# This recovery profile deliberately contains no second-factor, Redis, or
# object-storage contract values.

DATABASE_URL=op://humans-production/neon/database-url
ADMIN_EMAIL=op://humans-production/administrator/email
ADMIN_USERNAME=op://humans-production/administrator/username
ADMIN_DISPLAY_NAME=op://humans-production/administrator/display-name
ADMIN_PASSWORD=op://humans-production/administrator/password
