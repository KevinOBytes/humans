# This is a reference-only 1Password CLI template, not a populated environment
# file. Copy it to the ignored `.env.operator.op.tpl`, then change only the
# `op://` references to match the approved production vault. Never replace a
# reference in this file or its private copy with plaintext.

PRODUCTION_SMOKE_AUTH=1
PRODUCTION_SMOKE_2FA=1

DATABASE_URL=op://humans-production/neon/database-url
ADMIN_EMAIL=op://humans-production/administrator/email
ADMIN_USERNAME=op://humans-production/administrator/username
ADMIN_DISPLAY_NAME=op://humans-production/administrator/display-name
ADMIN_PASSWORD=op://humans-production/administrator/password

# 1Password resolves this reference to the current TOTP value for the item.
# To consume a one-time backup code instead, omit this variable and inject
# PRODUCTION_SMOKE_BACKUP_CODE from an approved one-time secret field.
PRODUCTION_SMOKE_TOTP=op://humans-production/administrator/one-time-password?attribute=otp

# External provider lifecycle checks are separately opt-in. Remove an entire
# provider group when it is not part of the selected deployment; a partial
# group fails closed before any external request.
RUN_EXTERNAL_PROVIDER_CONTRACTS=true
UPSTASH_REDIS_REST_URL=op://humans-production/upstash/rest-url
UPSTASH_REDIS_REST_TOKEN=op://humans-production/upstash/rest-token
TEST_STORAGE_PROVIDER=r2
TEST_STORAGE_ENDPOINT=op://humans-production/r2/endpoint
TEST_STORAGE_REGION=auto
TEST_STORAGE_BUCKET=op://humans-production/r2/private-bucket
TEST_STORAGE_ACCESS_KEY_ID=op://humans-production/r2/access-key-id
TEST_STORAGE_SECRET_ACCESS_KEY=op://humans-production/r2/secret-access-key
