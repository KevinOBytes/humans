# Reference-only 1Password CLI template for one S3-compatible contract smoke.
# Create its ignored local copy with:
#   install -m 600 docs/operations/production-storage-contracts.op.env.example .env.storage-contracts.op.tpl
# This profile contains no administrator, database, or Redis values.

RUN_EXTERNAL_PROVIDER_CONTRACTS=true
TEST_STORAGE_PROVIDER=r2
TEST_STORAGE_ENDPOINT=op://humans-production/r2/endpoint
TEST_STORAGE_REGION=auto
STORAGE_BUCKET=op://humans-production/r2/application-private-bucket
TEST_STORAGE_BUCKET=op://humans-production/r2/contract-test-bucket
TEST_STORAGE_ACCESS_KEY_ID=op://humans-production/r2/access-key-id
TEST_STORAGE_SECRET_ACCESS_KEY=op://humans-production/r2/secret-access-key
