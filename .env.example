# Deployment: "vercel" or "docker"
# Copy this file to the ignored `.env`, then replace every documentation-only
# value. Generate independent secrets; never deploy these placeholders.
DEPLOYMENT_MODE=docker
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL and Redis. Replace these documentation-only passwords locally.
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
DATABASE_URL=postgresql://humans:replace-with-a-strong-password@postgres:5432/humans
# Keep false for the application. Use the explicit Compose seed service or set
# true only for a deliberate one-off `pnpm db:seed` operation.
ALLOW_DATABASE_SEED=false
REDIS_URL=redis://:replace-with-a-strong-password@redis:6379
# Optional when the Redis URL already contains credentials.
REDIS_TOKEN=

# Private S3-compatible object storage (MinIO in the Docker quick start).
MINIO_ROOT_USER=replace-with-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-storage-secret-key
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=humans-private
STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_PUBLIC=false

# Authentication and application-level encryption.
# Generate AUTH_SECRET with: openssl rand -hex 32
# Generate AUTH_ENCRYPTION_KEY with: openssl rand -hex 32
# Generate DATA_ENCRYPTION_KEY with: openssl rand -hex 32
# Generate each HMAC key independently with: openssl rand -hex 32
AUTH_SECRET=replace-with-64-random-hex-characters
AUTH_SECURE_COOKIES=false
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Production defaults to invite-only when omitted. Local installations that
# intentionally allow open signup must opt in with "public".
AUTH_REGISTRATION_MODE=invite_only
AUTH_ENCRYPTION_KEY=replace-with-64-random-hex-characters
DATA_ENCRYPTION_KEY=replace-with-64-random-hex-characters
PROTECTED_LOOKUP_HMAC_KEY=replace-with-independent-64-random-hex-characters
OPERATION_LIMIT_HMAC_KEY=replace-with-independent-64-random-hex-characters
# Docker defaults to no trusted client-address header. Use "vercel" only on
# Vercel. Use "hmac" only behind an isolated Docker edge proxy that supplies
# the signed Humans headers; then generate an independent proxy key too.
TRUSTED_PROXY_MODE=none
TRUSTED_PROXY_HMAC_KEY=
# Required in Vercel mode for the bounded job runner endpoint.
CRON_SECRET=replace-with-an-independent-strong-cron-secret

# One-shot first-administrator bootstrap only. These values are consumed by
# `pnpm admin:bootstrap` or the opt-in Compose bootstrap service, not by the
# application, worker, migration, or seed processes. The initial password is
# used only when creating a missing credential and does not rotate an existing
# password.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=humans-admin
ADMIN_DISPLAY_NAME=Humans Administrator
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Transactional email through Resend.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Humans <humans@example.com>

# OpenAI-compatible analysis. Ollama does not require an API key.
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=
AI_MODEL=replace-with-enabled-model-name
