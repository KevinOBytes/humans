{
  "name": "humans",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.11.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "runtime:build": "node scripts/build-runtime-artifacts.mjs",
    "runtime:image:verify": "node scripts/verify-runtime-image.mjs",
    "runtime:image:optimizer": "node scripts/verify-runtime-image-optimizer.mjs",
    "runtime:sbom:verify": "node scripts/verify-runtime-sbom.mjs",
    "start": "next start",
    "worker": "node --conditions react-server --import tsx src/worker/run-continuous.ts",
    "jobs:run-once": "node --conditions react-server --import tsx src/worker/run-bounded.ts",
    "search:reindex": "node --conditions react-server --import tsx scripts/reindex-search.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:db": "vitest run tests/integration/core-schema.test.ts tests/integration/full-schema.test.ts tests/integration/core-schema-live.test.ts tests/integration/workspace-constraints.test.ts tests/integration/migration-upgrade-live.test.ts tests/integration/research-api.test.ts tests/integration/evidence-lifecycle.test.ts tests/integration/imports-api.test.ts tests/integration/import-worker.test.ts tests/integration/import-rows-graphql.test.ts tests/integration/files-api.test.ts tests/integration/file-cleanup.test.ts --no-file-parallelism",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "test:performance:graph": "GRAPH_PERFORMANCE=1 NODE_OPTIONS=--conditions=react-server playwright test --project graph-reference",
    "test:storage-browser": "NODE_OPTIONS=--conditions=react-server playwright test --config playwright.storage.config.ts",
    "test:compose:config": "vitest run tests/unit/compose-config.test.ts tests/unit/infrastructure-config.test.ts",
    "test:compose:smoke": "node scripts/compose-lifecycle.mjs smoke",
    "test:compose:lifecycle": "node scripts/compose-lifecycle.mjs lifecycle",
    "db:generate": "drizzle-kit generate --name core",
    "db:drift:check": "node scripts/check-drizzle-drift.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions react-server --import tsx src/db/migrate.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env.local --conditions react-server --import tsx src/db/bootstrap-admin-entry.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "drizzle-kit check",
    "auth:schema:generate": "auth generate --config scripts/better-auth-schema.ts --output .tmp/better-auth-schema.ts --yes",
    "auth:schema:check": "tsx scripts/check-better-auth-schema.ts",
    "codegen": "node --conditions react-server --import tsx node_modules/@graphql-codegen/cli/esm/bin.js --config codegen.ts",
    "codegen:check": "corepack pnpm codegen && git diff --exit-code -- src/graphql/generated",
    "deps:licenses": "node scripts/check-dependency-licenses.mjs",
    "deps:audit": "corepack pnpm audit --prod --audit-level high",
    "security:secrets": "node scripts/run-supply-chain-tool.mjs secrets",
    "sbom:generate": "node scripts/run-supply-chain-tool.mjs sbom",
    "security:image": "node scripts/run-supply-chain-tool.mjs image",
    "ci:contracts": "vitest run tests/unit/ci-workflow-contract.test.ts tests/unit/dependency-license-policy.test.ts tests/unit/repository-governance-contract.test.ts",
    "ci:validate": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:unit && corepack pnpm db:check && corepack pnpm db:drift:check && corepack pnpm auth:schema:check && corepack pnpm codegen:check && corepack pnpm deps:licenses && corepack pnpm deps:audit && corepack pnpm build",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1084.0",
    "@aws-sdk/s3-request-presigner": "3.1084.0",
    "@better-auth/api-key": "1.6.23",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@escape.tech/graphql-armor-max-aliases": "2.6.2",
    "@escape.tech/graphql-armor-max-tokens": "2.5.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@graphql-yoga/plugin-csrf-prevention": "3.21.2",
    "@graphql-yoga/plugin-disable-introspection": "2.22.2",
    "@pothos/core": "4.13.1",
    "@pothos/plugin-complexity": "4.2.1",
    "@pothos/plugin-dataloader": "4.4.5",
    "@react-sigma/core": "5.0.6",
    "@react-sigma/layout-forceatlas2": "5.0.6",
    "@smithy/node-http-handler": "4.9.4",
    "@upstash/redis": "1.38.0",
    "@xyflow/react": "12.11.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.1",
    "dataloader": "2.2.3",
    "decode-named-character-reference": "1.3.0",
    "drizzle-orm": "0.45.2",
    "file-type": "22.0.1",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-metrics": "2.4.0",
    "graphology-shortest-path": "2.1.0",
    "graphql": "16.14.2",
    "graphql-scalars": "1.25.0",
    "graphql-yoga": "5.21.2",
    "ioredis": "5.11.1",
    "lucide-react": "1.28.0",
    "mdast-util-from-markdown": "2.0.3",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.17.6",
    "server-only": "^0.0.1",
    "sigma": "3.0.3",
    "stream-json": "3.5.0",
    "tailwind-merge": "3.6.0",
    "uuidv7": "1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/client-preset": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "@vercel/nft": "1.10.2",
    "@vitejs/plugin-react": "^6.0.3",
    "auth": "1.6.23",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "4.23.0",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
